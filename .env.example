# Pooled connection. The Neon integration on Vercel sets this.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct connection for Prisma migrations. The Neon integration sets this too.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require"

# Shared team password. Set a long one in Vercel. This example is for local use only.
APP_PASSWORD="choose-a-team-password"

# Signs the session cookie. Use a different long random string in Vercel.
SESSION_SECRET="choose-a-random-string-at-least-32-characters"

# Leave unset on the production site. Set to true locally to add fictional trainees.
SEED_SAMPLE_DATA="true"

# Optional. Bearer token for POST /api/sync/roster. Leave unset until a weekly sync is ready.
# SYNC_TOKEN=""

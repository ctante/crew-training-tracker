generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model RosterSync {
  id           String   @id @default(cuid())
  source       String
  createdAt    DateTime @default(now())
  rowsRead         Int
  updatedCount     Int
  createdCount     Int
  skippedCount     Int
  deactivatedCount Int      @default(0)
  note             String   @default("")
}

model Store {
  id             String    @id @default(cuid())
  number         String    @unique
  name           String    @default("")
  passwordHash   String?
  sessionVersion Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  staff          Staff[]
  trainees       Trainee[]
  appUsers       AppUserStore[]
}

model AppUser {
  id             String         @id @default(cuid())
  name           String
  login          String         @unique
  passwordHash   String
  role           String
  allStores      Boolean        @default(false)
  active         Boolean        @default(true)
  sessionVersion Int            @default(1)
  lastSignedInAt DateTime?
  permissionOverrides Json      @default("{}")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  stores         AppUserStore[]
}

model RoleDefault {
  role        String @id
  permissions Json
}

model AppUserStore {
  userId String
  storeId String
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
  @@index([storeId])
}

model Staff {
  id           String          @id @default(cuid())
  storeId      String
  store        Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name         String
  position     String          @default("")
  isGm         Boolean         @default(false)
  isTrainer    Boolean         @default(false)
  qualified    Boolean         @default(false)
  rosterSource String          @default("manual")
  active       Boolean         @default(true)
  isSample     Boolean         @default(false)
  createdAt    DateTime        @default(now())
  assignments  TraineeModule[]

  @@index([storeId])
}

model Module {
  id           String          @id @default(cuid())
  language     String
  section      String
  sectionLabel String
  sortOrder    Int
  name         String
  timeLabel    String          @default("")
  timeMinutes  Int?
  videoCount   Int?
  credit       String?
  link         String          @default("")
  videoTitles  String          @default("")
  needsReview  Boolean         @default(false)
  linkVerified Boolean         @default(false)
  kind         String
  note         String          @default("")
  archived     Boolean         @default(false)
  manualTranslation Boolean    @default(false)
  progress     TraineeModule[]

  @@unique([language, sortOrder])
  @@index([language])
}

model Trainee {
  id        String          @id @default(cuid())
  storeId   String
  store     Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  startDate String
  language  String
  position  String          @default("")
  path                 String?
  secondPath           String?
  firstPathCompletedOn String?
  status               String          @default("ACTIVE")
  isSample  Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  modules   TraineeModule[]

  @@index([storeId])
  @@index([status])
}

model TraineeModule {
  id            String  @id @default(cuid())
  traineeId     String
  trainee       Trainee @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  moduleId      String
  module        Module  @relation(fields: [moduleId], references: [id])
  scheduledDate String?
  trainerId     String?
  trainer       Staff?  @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  trainerLabel  String  @default("")
  completed     Boolean @default(false)
  completedDate String?
  notes         String  @default("")

  @@unique([traineeId, moduleId])
  @@index([traineeId])
  @@index([scheduledDate])
}
